rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /articles/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /authors/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /ads/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /activityLogs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /subscribers/{id} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /donations/{id} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
