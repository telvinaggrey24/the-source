rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Sole CMS owner — no other Google account may write
      return isSignedIn() && request.auth.token.email == 'telvinaggrey24@gmail.com';
    }

    match /articles/{id} {
      // Public can read published posts; admin can read/write everything
      allow read: if isAdmin() || (resource.data.keys().hasAll(['status']) && resource.data.status == 'published');
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'status', 'categoryId'])
        && request.resource.data.get('isWireStory', false) == false;
      allow update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /authors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == id);
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /subscribers/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /donations/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
